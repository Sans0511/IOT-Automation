# Local MongoDB
DATABASE_URL="mongodb://localhost:27017/iot-automation"

# MongoDB Atlas
# DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/iot-automation"

# Redis Cloud: endpoint + port from Configuration > Access, password from Default user
REDIS_URL="redis://default:<password>@<endpoint>:<port>"

# JWT secrets (use long random values)
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# MQTT broker (mqtt://, mqtts://, ws://, or wss://)
MQTT_BROKER_URL="mqtt://localhost:1883"

# Redis TTL for the latest device status snapshots only, not telemetry (seconds)
MQTT_CACHE_TTL_SECONDS="86400"

# Standalone WebSocket server
WS_PORT="3001"
WEBSOCKET_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Browser WebSocket URL (public value, included in the client bundle)
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
