# Local MongoDB
DATABASE_URL="mongodb://localhost:27017/iot-automation"

# MongoDB Atlas
# DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/iot-automation"

# Redis Cloud: endpoint + port from Configuration > Access, password from Default user
REDIS_URL="redis://default:<password>@<endpoint>:<port>"

# JWT secrets (use long random values)
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
