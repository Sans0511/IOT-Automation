generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String?
  email     String   @unique
  password  String // Hashed password (bcrypt)
  role      Role     @default(USER)
  farms     Farm[]   @relation("UserFarms")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Farm {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  name     String // e.g., "North Valley Farm"
  location String // e.g., "Salem"

  ownerId String @db.ObjectId
  owner   User   @relation("UserFarms", fields: [ownerId], references: [id], onDelete: Cascade)

  devices   Device[] // Relation to IoT devices in this farm
  layout    FarmLayout?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([ownerId])
}

model Device {
  id   String     @id @default(auto()) @map("_id") @db.ObjectId
  name String // e.g., "Valve 01", "Soil Moisture Sensor A"
  type DeviceType

  farmId String @db.ObjectId
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([farmId, type])
}

model FarmLayout {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  farmId String @unique @db.ObjectId
  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  width           Int    @default(1200)
  height          Int    @default(800)
  backgroundKey   String @default("classic-farm")
  placements      Json
  backgroundItems Json?
  connections     Json?
  version         Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DeviceType {
  VALVE
  MOISTURE_SENSOR
  PUMP
  WEATHER_STATION
  MOTOR_PUMP
  SOLENOID_VALVE
  SMART_IRRIGATION_CONTROLLER
  RAIN_DETECTION
}

enum Role {
  ADMIN
  USER
}
